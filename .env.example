# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key. Safe in the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key. SERVER ONLY: bypasses RLS.
# Used only by src/lib/supabase/admin.ts. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Google Books fallback (optional, server only)
GOOGLE_BOOKS_API_KEY=

# Email or URL for the Open Library User-Agent header
OPEN_LIBRARY_CONTACT=
